# Docker Compose Configuration
COMPOSE_PROJECT_NAME=task-management

# Database Configuration
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass

# Database URL for the API
DATABASE_URL=postgresql://taskuser:taskpass@postgres:5432/taskdb

# Application Configuration
APP_NAME=Task Management API
APP_VERSION=1.0.0

# Authentication Configuration
# External IdP configuration (issuer, audience, JWKS endpoint). Tokens must
# carry a `scope` (or `scp`) claim with `tasks:read` (GET calls) and/or
# `tasks:write` (POST/PUT/DELETE calls) - neither scope implies the other.
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=task-management-api
# JWT_JWK_URL=https://idp.example.com/.well-known/jwks.json
# JWT_ALGORITHMS=RS256
# JWT_LEEWAY_SECONDS=0

# Static HTTP Basic auth credentials, provided via external configuration (a
# Kubernetes Secret in production). Alternative to a JWT: valid credentials
# grant the admin role, both scopes (full access).
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
