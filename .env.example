# Docker Compose Configuration
COMPOSE_PROJECT_NAME=task-management

# Database Configuration
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass

# Database URL for the API
DATABASE_URL=postgresql://taskuser:taskpass@postgres:5432/taskdb

# Application Configuration
APP_NAME=Task Management API
APP_VERSION=1.0.0

# Authentication Configuration
# Set to true to disable JWT enforcement (local dev, matches previous no-auth behavior)
AUTH_DISABLED=true

# External IdP configuration (issuer, audience, JWKS endpoint), required
# when AUTH_DISABLED=false. Tokens must carry a `scope` (or `scp`) claim with
# `tasks:read` (read-only calls) and/or `tasks:full` (all calls).
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=task-management-api
# JWT_JWK_URL=https://idp.example.com/.well-known/jwks.json
# JWT_ALGORITHMS=RS256
# JWT_LEEWAY_SECONDS=0
